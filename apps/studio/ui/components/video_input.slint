// Reusable video identity and file picker. Pages own probe state and choose callbacks.
import { Theme } from "../theme.slint";
import { ActionButton } from "controls.slint";

export component VideoInfo inherits VerticalLayout {
    in property <bool> selected: true;
    in property <string> name;
    in property <string> details;
    in property <length> name-font-size: 13.5px;
    in property <length> details-font-size: 11.5px;
    in property <color> details-color: Theme.text3;
    in property <length> name-height: 0px;
    in property <length> details-height: 0px;
    spacing: 5px;
    min-width: 0px;
    Text {
        text: root.name;
        font-family: root.selected ? Theme.mono-font : "Inter";
        font-size: root.name-font-size;
        font-weight: 600;
        color: Theme.text;
        height: root.name-height > 0px ? root.name-height : self.preferred-height;
        min-width: 0px;
        overflow: elide;
        vertical-alignment: root.name-height > 0px ? center : top;
    }
    Text {
        text: root.details;
        font-size: root.details-font-size;
        color: root.details-color;
        height: root.details-height > 0px ? root.details-height : self.preferred-height;
        min-width: 0px;
        overflow: elide;
        vertical-alignment: root.details-height > 0px ? center : top;
    }
}

export component VideoInput inherits Rectangle {
    in property <bool> distorted: false;
    in property <bool> selected: false;
    in property <string> name;
    in property <string> path;
    in property <[string]> chips;
    callback choose();
    min-width: 0px;
    height: 242px;
    vertical-stretch: 0;
    background: Theme.bg2;
    border-width: 1px;
    border-color: Theme.stroke2;
    border-radius: 10px;
    property <color> role-color: distorted ? Theme.fair : Theme.accent;
    VerticalLayout {
        padding: 24px;
        spacing: 0;
        alignment: start;
        HorizontalLayout {
            height: 26px;
            spacing: 12px;
            Rectangle { width: 4px; height: 23px; border-radius: 2px; background: root.role-color; }
            Text { text: root.distorted ? @tr("Distorted video") : @tr("Reference video"); font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            // A short caption beside the title; Chinese keeps the English role names.
            Text { text: root.distorted ? @tr("role caption" => "UNDER TEST") : @tr("role caption" => "SOURCE"); font-size: 11px; letter-spacing: 0.6px; color: Theme.text2; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Image { source: @image-url("../icons/film.svg"); width: 23px; height: 23px; colorize: Theme.text2; }
        }
        Rectangle { height: 21px; }
        VideoInfo {
            selected: root.selected;
            name: root.selected ? root.name : root.distorted ? @tr("Add a video to test") : @tr("Add a reference video");
            details: root.selected ? root.path : root.distorted ? @tr("The compressed video whose quality is evaluated.") : @tr("The original high-quality video used as the baseline.");
            name-font-size: root.selected ? 16px : 21px;
            name-height: 30px;
            details-font-size: 12.5px;
            details-color: Theme.text2;
            details-height: 20px;
        }
        Rectangle { height: 18px; }
        HorizontalLayout {
            height: 40px;
            spacing: 15px;
            ActionButton {
                text: root.selected ? @tr("Change file") : @tr("Choose file");
                accessible-name: root.distorted ? @tr("Choose distorted video file") : @tr("Choose reference video file");
                icon: @image-url("../icons/folder-open.svg");
                clicked => { root.choose(); }
            }
            VerticalLayout { width: 1px; alignment: center; Rectangle { height: 17px; background: Theme.stroke2; } }
            Text { text: root.selected ? @tr("Local file selected") : @tr("Import from this computer"); color: Theme.text2; font-size: 12px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 17px; }
        Text {
            text: !root.selected ? @tr("Supports MP4, MKV, MOV and other common formats")
                : root.chips[0] + (root.chips.length > 1 ? " · " + root.chips[1] : "")
                    + (root.chips.length > 2 ? " · " + root.chips[2] : "")
                    + (root.chips.length > 3 ? " · " + root.chips[3] : "")
                    + (root.chips.length > 4 ? " · " + root.chips[4] : "")
                    + (root.chips.length > 5 ? " · " + root.chips[5] : "");
            font-size: 11.5px;
            color: Theme.text2;
            height: 18px;
            min-width: 0px;
            overflow: elide;
        }
    }
}

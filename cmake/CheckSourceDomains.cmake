# Check both source ownership and the transitive CPU-reference link boundary.
# This runs at configure time; the GPU source check also runs on every build.
set(crossvmaf_source_domains evaluation video metrics gpu scoring numeric)
file(GLOB source_entries RELATIVE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/src/*")
foreach(source_entry IN LISTS source_entries)
    if(NOT source_entry IN_LIST crossvmaf_source_domains)
        message(FATAL_ERROR "Unexpected source domain: src/${source_entry}")
    endif()
endforeach()

file(GLOB_RECURSE domain_sources
    "${PROJECT_SOURCE_DIR}/src/*.cpp"
    "${PROJECT_SOURCE_DIR}/src/*.hpp")
foreach(source_path IN LISTS domain_sources)
    file(RELATIVE_PATH relative_path "${PROJECT_SOURCE_DIR}/src" "${source_path}")
    string(REGEX REPLACE "/.*$" "" domain "${relative_path}")
    file(READ "${source_path}" source_contents)
    set(forbidden_includes "")
    if(domain STREQUAL "numeric")
        set(forbidden_includes "evaluation/|video/|metrics/|gpu/|scoring/|libav")
    elseif(domain STREQUAL "video")
        set(forbidden_includes "evaluation/|metrics/|scoring/")
    elseif(domain STREQUAL "metrics")
        set(forbidden_includes "evaluation/|scoring/|libav")
    elseif(domain STREQUAL "scoring")
        set(forbidden_includes "evaluation/|video/|gpu/|libav|metrics/[^/]+/(vulkan|reference)\\.hpp")
    endif()
    if(forbidden_includes AND source_contents MATCHES
       "#[ \t]*include[ \t]*[\"<](${forbidden_includes})")
        message(FATAL_ERROR "Forbidden ${domain} dependency in ${relative_path}: ${CMAKE_MATCH_0}")
    endif()
    if(NOT domain STREQUAL "video" AND source_contents MATCHES
       "#[ \t]*include[ \t]*[\"<](libav|video/ffmpeg\\.hpp)")
        message(FATAL_ERROR "FFmpeg escaped the video boundary: ${relative_path}")
    endif()
    if(source_contents MATCHES
       "(FramePairStorageProvider|FramePairPrefetcher|VulkanSession|OrderedResultBuffer|PendingSpatialFrame|FeaturePlan|pending_timings_)")
        message(FATAL_ERROR "Removed production architecture reappeared: ${relative_path}")
    endif()
endforeach()

if(TARGET crossvmaf_reference_verification)
    set(pending_targets crossvmaf_reference_verification)
    set(visited_targets)
    while(pending_targets)
        list(POP_FRONT pending_targets current_target)
        if(current_target IN_LIST visited_targets OR NOT TARGET "${current_target}")
            continue()
        endif()
        list(APPEND visited_targets "${current_target}")
        if(current_target MATCHES "^(crossvmaf|crossvmaf_gpu|crossvmaf_video|crossvmaf_.*_vulkan|volk::volk)$")
            message(FATAL_ERROR "CPU reference transitively links production execution: ${current_target}")
        endif()
        get_target_property(link_targets "${current_target}" LINK_LIBRARIES)
        get_target_property(interface_targets "${current_target}" INTERFACE_LINK_LIBRARIES)
        foreach(link_target IN LISTS link_targets interface_targets)
            string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" link_target "${link_target}")
            if(TARGET "${link_target}")
                list(APPEND pending_targets "${link_target}")
            endif()
        endforeach()
    endwhile()
endif()

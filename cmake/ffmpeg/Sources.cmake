# Upstream's libavcodec/file_open.c and libavformat/file_open.c are one-line
# `#include "libavutil/file_open.c"` shims that exist only because version
# scripts hide ff_fopen_utf8/ff_open/ff_tempfile from sibling shared
# libraries. The combined CrossVMAF shared library compiles
# libavutil/file_open.c once for all sides, so the shims are excluded.

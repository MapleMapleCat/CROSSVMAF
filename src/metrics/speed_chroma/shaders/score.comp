bool q_divide_by_u32(
    uvec2 numerator, CvPreparedU32Divider divider,
    out uvec2 output_value) {
    if (!cv_q32_divide_by_u32_prepared_rne(
            numerator, divider, output_value)) {
        return false;
    }
    output_value = cv_binary32_quantize(output_value);
    return true;
}

bool q_log2(uvec2 value, out uvec2 output_value) {
    return cv_q32_log2(value, output_value);
}

uvec2 l_from_q32(uvec2 value) {
    return cv_q32_to_q48_saturating(value);
}

uvec2 l_scale(uvec2 value, int exponent) {
    return cv_i64_scale_pow2_rne_saturating(value, exponent);
}

bool l_scale_checked(uvec2 value, int exponent, out uvec2 output_value) {
    if (cv_u64_is_zero(value) || exponent == 0) {
        output_value = value;
        return true;
    }
    if (exponent < 0) {
        output_value = cv_i64_scale_pow2_rne_saturating(value, exponent);
        return true;
    }
    const uint shift = uint(exponent);
    if (shift >= 64u) return false;
    const bool negative = cv_i64_negative(value);
    const uvec2 magnitude = cv_i64_magnitude(value);
    const uvec2 signed_limit = negative
        ? uvec2(0u, 0x80000000u)
        : uvec2(0xffffffffu, 0x7fffffffu);
    const uvec2 maximum_input = cv_u64_shift_right(signed_limit, shift);
    if (cv_u64_less(maximum_input, magnitude)) return false;
    const uvec2 shifted = cv_u64_shift_left(magnitude, shift);
    output_value = negative ? cv_u64_negate(shifted) : shifted;
    return true;
}

int q_normalization_exponent_from_magnitude(uvec2 largest_magnitude) {
    const int highest_bit = cv_u64_msb(largest_magnitude);
    return highest_bit < 0 ? 0 : 32 - highest_bit;
}

int q_scratch_normalization_exponent(uint base, uint count) {
    uvec2 largest_magnitude = uvec2(0u);
    for (uint index = 0u; index < count; ++index) {
        const uvec2 magnitude = cv_i64_magnitude(scratch.values[base + index]);
        if (cv_u64_less(largest_magnitude, magnitude)) {
            largest_magnitude = magnitude;
        }
    }
    return q_normalization_exponent_from_magnitude(largest_magnitude);
}

bool l_convert_public_with_exponent(
    uvec2 value, int normalization_exponent, out uvec2 output_value) {
    return l_scale_checked(value, normalization_exponent + 16, output_value);
}

bool l_to_q32_scaled_checked(
    uvec2 value, int exponent, out uvec2 output_value) {
    return l_scale_checked(value, exponent - 16, output_value);
}

uvec2 l_absolute(uvec2 value) {
    return cv_i64_apply_magnitude_saturating(
        cv_i64_magnitude(value), false, false);
}

uvec2 l_negate(uvec2 value) {
    return cv_q32_subtract_saturating(l_zero, value);
}

bool l_less(uvec2 lhs, uvec2 rhs) {
    return cv_i64_less(lhs, rhs);
}

uvec2 l_add(uvec2 lhs, uvec2 rhs) {
    return cv_q48_binary32_add(lhs, rhs);
}

uvec2 l_subtract(uvec2 lhs, uvec2 rhs) {
    return cv_q48_binary32_subtract(lhs, rhs);
}

uvec2 l_multiply(uvec2 lhs, uvec2 rhs) {
    return cv_q48_binary32_multiply(lhs, rhs);
}

bool l_divide(uvec2 numerator, uvec2 denominator, out uvec2 output_value) {
#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 2 || \
    CROSSVMAF_SPEED_CHROMA_PIPELINE == 3 || \
    CROSSVMAF_SPEED_CHROMA_PIPELINE == 7
    return cv_q48_binary32_divide_base16(
        numerator, denominator, output_value);
#else
    return cv_q48_binary32_divide(numerator, denominator, output_value);
#endif
}

uvec2 l_from_uint(uint value) {
    return uvec2(0u, value << 16u);
}

int l_value_normalization_exponent(uvec2 value) {
    const int highest_bit = cv_u64_msb(cv_i64_magnitude(value));
    return highest_bit < 0 ? 0 : 48 - highest_bit;
}

int l_scratch_normalization_exponent(uint base, uint count) {
    uvec2 largest = uvec2(0u);
    for (uint index = 0u; index < count; ++index) {
        const uvec2 magnitude = cv_i64_magnitude(scratch.values[base + index]);
        if (cv_u64_less(largest, magnitude)) largest = magnitude;
    }
    const int highest_bit = cv_u64_msb(largest);
    return highest_bit < 0 ? 0 : 48 - highest_bit;
}

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 6
uint exact_wide_limb_index(uint slot, uint limb_index) {
    return limb_index * exact_wide_slot_count + slot;
}

uint load_wide_limb(uint slot, uint limb_index) {
    return exact_wide_limbs[exact_wide_limb_index(slot, limb_index)];
}

void store_wide_limb(uint slot, uint limb_index, uint value) {
    exact_wide_limbs[exact_wide_limb_index(slot, limb_index)] = value;
}

void clear_wide_unsigned(uint slot) {
    for (uint index = 0u; index < characteristic_integer_limb_count; ++index) {
        store_wide_limb(slot, index, 0u);
    }
    exact_wide_used_limb_counts[slot] = 0u;
}

void clear_wide_signed(uint slot) {
    clear_wide_unsigned(slot);
    exact_wide_signs[slot] = 0;
}

void copy_wide_signed(uint destination_slot, uint source_slot) {
    for (uint index = 0u; index < characteristic_integer_limb_count; ++index) {
        store_wide_limb(
            destination_slot, index, load_wide_limb(source_slot, index));
    }
    exact_wide_used_limb_counts[destination_slot] =
        exact_wide_used_limb_counts[source_slot];
    exact_wide_signs[destination_slot] = exact_wide_signs[source_slot];
}

void normalize_wide_unsigned(uint slot) {
    while (exact_wide_used_limb_counts[slot] > 0u &&
           load_wide_limb(
               slot, exact_wide_used_limb_counts[slot] - 1u) == 0u) {
        --exact_wide_used_limb_counts[slot];
    }
}

void make_wide_signed(uvec2 value, uint output_slot) {
    clear_wide_signed(output_slot);
    if (cv_u64_is_zero(value)) return;
    exact_wide_signs[output_slot] = cv_i64_negative(value) ? -1 : 1;
    const uvec2 magnitude = cv_i64_magnitude(value);
    store_wide_limb(output_slot, 0u, magnitude.x);
    store_wide_limb(output_slot, 1u, magnitude.y);
    exact_wide_used_limb_counts[output_slot] =
        magnitude.y != 0u ? 2u : 1u;
}

void make_wide_positive_one(uint output_slot) {
    clear_wide_signed(output_slot);
    exact_wide_signs[output_slot] = 1;
    store_wide_limb(output_slot, 0u, 1u);
    exact_wide_used_limb_counts[output_slot] = 1u;
}

int compare_wide_unsigned(uint lhs_slot, uint rhs_slot) {
    if (exact_wide_used_limb_counts[lhs_slot] !=
        exact_wide_used_limb_counts[rhs_slot]) {
        return exact_wide_used_limb_counts[lhs_slot] <
                exact_wide_used_limb_counts[rhs_slot]
            ? -1
            : 1;
    }
    for (uint reverse_index = exact_wide_used_limb_counts[lhs_slot];
         reverse_index > 0u; --reverse_index) {
        const uint index = reverse_index - 1u;
        const uint lhs_limb = load_wide_limb(lhs_slot, index);
        const uint rhs_limb = load_wide_limb(rhs_slot, index);
        if (lhs_limb != rhs_limb) {
            return lhs_limb < rhs_limb ? -1 : 1;
        }
    }
    return 0;
}

bool add_wide_unsigned(
    uint lhs_slot, uint rhs_slot, uint output_slot) {
    clear_wide_unsigned(output_slot);
    const uint limb_count = max(
        exact_wide_used_limb_counts[lhs_slot],
        exact_wide_used_limb_counts[rhs_slot]);
    uint carry = 0u;
    for (uint index = 0u; index < limb_count; ++index) {
        const uint lhs_limb = index < exact_wide_used_limb_counts[lhs_slot]
            ? load_wide_limb(lhs_slot, index)
            : 0u;
        const uint rhs_limb = index < exact_wide_used_limb_counts[rhs_slot]
            ? load_wide_limb(rhs_slot, index)
            : 0u;
        const uint partial = lhs_limb + rhs_limb;
        const bool partial_overflow = partial < lhs_limb;
        const uint result_limb = partial + carry;
        const bool carry_overflow = result_limb < partial;
        store_wide_limb(output_slot, index, result_limb);
        carry = partial_overflow || carry_overflow ? 1u : 0u;
    }
    exact_wide_used_limb_counts[output_slot] = limb_count;
    if (carry != 0u) {
        if (exact_wide_used_limb_counts[output_slot] ==
            characteristic_integer_limb_count) {
            return false;
        }
        store_wide_limb(
            output_slot, exact_wide_used_limb_counts[output_slot], carry);
        ++exact_wide_used_limb_counts[output_slot];
    }
    normalize_wide_unsigned(output_slot);
    return true;
}

void subtract_wide_unsigned(
    uint lhs_slot, uint rhs_slot, uint output_slot) {
    clear_wide_unsigned(output_slot);
    uint borrow = 0u;
    for (uint index = 0u;
         index < exact_wide_used_limb_counts[lhs_slot]; ++index) {
        const uint lhs_limb = load_wide_limb(lhs_slot, index);
        const uint rhs_limb = index < exact_wide_used_limb_counts[rhs_slot]
            ? load_wide_limb(rhs_slot, index)
            : 0u;
        const uint partial = lhs_limb - rhs_limb;
        const bool rhs_borrow = lhs_limb < rhs_limb;
        const uint result_limb = partial - borrow;
        const bool carry_borrow = partial < borrow;
        store_wide_limb(output_slot, index, result_limb);
        borrow = rhs_borrow || carry_borrow ? 1u : 0u;
    }
    exact_wide_used_limb_counts[output_slot] =
        exact_wide_used_limb_counts[lhs_slot];
    normalize_wide_unsigned(output_slot);
}

bool add_wide_product_word(
    uint output_slot, uint base_index, uint lhs, uint rhs) {
    if (lhs == 0u || rhs == 0u) return true;
    uint product_high;
    uint product_low;
    umulExtended(lhs, rhs, product_high, product_low);
    if (base_index >= characteristic_integer_limb_count) return false;

    const uint prior_low = load_wide_limb(output_slot, base_index);
    const uint low_sum = prior_low + product_low;
    store_wide_limb(output_slot, base_index, low_sum);
    uint carry = low_sum < prior_low ? 1u : 0u;
    uint index = base_index + 1u;
    if (index >= characteristic_integer_limb_count) {
        return product_high == 0u && carry == 0u;
    }

    const uint prior_high = load_wide_limb(output_slot, index);
    const uint high_sum = prior_high + product_high;
    const bool high_overflow = high_sum < prior_high;
    const uint high_sum_with_carry = high_sum + carry;
    store_wide_limb(output_slot, index, high_sum_with_carry);
    const bool carry_overflow = high_sum_with_carry < high_sum;
    carry = high_overflow || carry_overflow ? 1u : 0u;
    ++index;
    while (carry != 0u) {
        if (index >= characteristic_integer_limb_count) return false;
        const uint incremented_limb = load_wide_limb(output_slot, index) + 1u;
        store_wide_limb(output_slot, index, incremented_limb);
        carry = incremented_limb == 0u ? 1u : 0u;
        ++index;
    }
    return true;
}

bool multiply_wide_unsigned_u64(
    uint value_slot, uvec2 factor, uint output_slot) {
    clear_wide_unsigned(output_slot);
    for (uint value_index = 0u;
         value_index < exact_wide_used_limb_counts[value_slot]; ++value_index) {
        const uint value_limb = load_wide_limb(value_slot, value_index);
        if (!add_wide_product_word(
                output_slot, value_index, value_limb, factor.x) ||
            !add_wide_product_word(
                output_slot, value_index + 1u, value_limb, factor.y)) {
            return false;
        }
    }
    exact_wide_used_limb_counts[output_slot] =
        characteristic_integer_limb_count;
    normalize_wide_unsigned(output_slot);
    return true;
}

bool multiply_wide_unsigned_u128(
    uint value_slot, uvec4 factor, uint output_slot) {
    clear_wide_unsigned(output_slot);
    for (uint value_index = 0u;
         value_index < exact_wide_used_limb_counts[value_slot]; ++value_index) {
        const uint value_limb = load_wide_limb(value_slot, value_index);
        for (uint factor_index = 0u; factor_index < 4u; ++factor_index) {
            if (!add_wide_product_word(
                    output_slot, value_index + factor_index,
                    value_limb, factor[factor_index])) {
                return false;
            }
        }
    }
    exact_wide_used_limb_counts[output_slot] =
        characteristic_integer_limb_count;
    normalize_wide_unsigned(output_slot);
    return true;
}

bool multiply_wide_signed(
    uint value_slot, uvec2 factor, uint output_slot) {
    clear_wide_signed(output_slot);
    if (exact_wide_signs[value_slot] == 0 || cv_u64_is_zero(factor)) {
        return true;
    }
    if (!multiply_wide_unsigned_u64(
            value_slot, cv_i64_magnitude(factor), output_slot)) {
        return false;
    }
    exact_wide_signs[output_slot] = cv_i64_negative(factor)
        ? -exact_wide_signs[value_slot]
        : exact_wide_signs[value_slot];
    return true;
}

bool multiply_wide_signed_unsigned128(
    uint value_slot, uvec4 factor, uint output_slot) {
    clear_wide_signed(output_slot);
    if (exact_wide_signs[value_slot] == 0 ||
        all(equal(factor, uvec4(0u)))) {
        return true;
    }
    if (!multiply_wide_unsigned_u128(
            value_slot, factor, output_slot)) {
        return false;
    }
    exact_wide_signs[output_slot] = exact_wide_signs[value_slot];
    return true;
}

void initialize_polynomial_pair_cooperatively(
    uint previous_slot, uint current_slot) {
    const uint local_lane = gl_LocalInvocationID.x;
    for (uint limb_index = local_lane;
         limb_index < characteristic_integer_limb_count;
         limb_index += gl_WorkGroupSize.x) {
        store_wide_limb(
            previous_slot, limb_index, limb_index == 0u ? 1u : 0u);
        store_wide_limb(current_slot, limb_index, 0u);
    }
    if (local_lane == 0u) {
        exact_wide_used_limb_counts[previous_slot] = 1u;
        exact_wide_signs[previous_slot] = 1;
        exact_wide_used_limb_counts[current_slot] = 0u;
        exact_wide_signs[current_slot] = 0;
    }
    barrier();
}

void make_wide_signed_cooperatively(uvec2 value, uint output_slot) {
    const uint local_lane = gl_LocalInvocationID.x;
    const uvec2 magnitude = cv_i64_magnitude(value);
    for (uint limb_index = local_lane;
         limb_index < characteristic_integer_limb_count;
         limb_index += gl_WorkGroupSize.x) {
        uint output_limb = 0u;
        if (limb_index == 0u) {
            output_limb = magnitude.x;
        } else if (limb_index == 1u) {
            output_limb = magnitude.y;
        }
        store_wide_limb(output_slot, limb_index, output_limb);
    }
    if (local_lane == 0u) {
        exact_wide_used_limb_counts[output_slot] = magnitude.y != 0u
            ? 2u
            : (magnitude.x != 0u ? 1u : 0u);
        exact_wide_signs[output_slot] = cv_u64_is_zero(value)
            ? 0
            : (cv_i64_negative(value) ? -1 : 1);
    }
    barrier();
}

uint exact_product_workspace_index(
    uint product_index, uint accumulator_index, uint column_index) {
    return ((product_index * exact_product_accumulator_count +
             accumulator_index) * exact_product_column_count) +
        column_index;
}

void accumulate_exact_product_word(
    uint product_index, uint column_index, uint word) {
    if (word == 0u) return;
    const uint low_word_index = exact_product_workspace_index(
        product_index, exact_product_low_accumulator, column_index);
    const uint high_word_index = exact_product_workspace_index(
        product_index, exact_product_high_accumulator, column_index);
    const uint prior_low = atomicAdd(exact_wide_workspace[low_word_index], word);
    if (prior_low + word < prior_low) {
        atomicAdd(exact_wide_workspace[high_word_index], 1u);
    }
}

bool finalize_exact_recurrence_products(
    int diagonal_output_sign, int coupling_output_sign) {
    uint diagonal_incoming_carry = 0u;
    uint coupling_incoming_carry = 0u;
    uint diagonal_used_limb_count = 0u;
    uint coupling_used_limb_count = 0u;
    bool diagonal_overflowed = false;
    bool coupling_overflowed = false;
    for (uint column_index = 0u;
         column_index < exact_product_column_count; ++column_index) {
        const uint diagonal_column_low = exact_wide_workspace[
            exact_product_workspace_index(
                exact_diagonal_product_index, exact_product_low_accumulator,
                column_index)];
        const uint diagonal_column_high = exact_wide_workspace[
            exact_product_workspace_index(
                exact_diagonal_product_index, exact_product_high_accumulator,
                column_index)];
        const uint coupling_column_low = exact_wide_workspace[
            exact_product_workspace_index(
                exact_coupling_product_index, exact_product_low_accumulator,
                column_index)];
        const uint coupling_column_high = exact_wide_workspace[
            exact_product_workspace_index(
                exact_coupling_product_index, exact_product_high_accumulator,
                column_index)];

        const uint diagonal_output_limb =
            diagonal_column_low + diagonal_incoming_carry;
        const uint coupling_output_limb =
            coupling_column_low + coupling_incoming_carry;
        const uint diagonal_carry_from_low =
            diagonal_output_limb < diagonal_column_low ? 1u : 0u;
        const uint coupling_carry_from_low =
            coupling_output_limb < coupling_column_low ? 1u : 0u;
        diagonal_incoming_carry =
            diagonal_column_high + diagonal_carry_from_low;
        coupling_incoming_carry =
            coupling_column_high + coupling_carry_from_low;

        if (column_index < characteristic_integer_limb_count) {
            store_wide_limb(
                exact_diagonal_product_slot, column_index,
                diagonal_output_limb);
            store_wide_limb(
                exact_coupling_product_slot, column_index,
                coupling_output_limb);
            if (diagonal_output_limb != 0u) {
                diagonal_used_limb_count = column_index + 1u;
            }
            if (coupling_output_limb != 0u) {
                coupling_used_limb_count = column_index + 1u;
            }
        } else {
            diagonal_overflowed =
                diagonal_overflowed || diagonal_output_limb != 0u;
            coupling_overflowed =
                coupling_overflowed || coupling_output_limb != 0u;
        }
    }
    diagonal_overflowed =
        diagonal_overflowed || diagonal_incoming_carry != 0u;
    coupling_overflowed =
        coupling_overflowed || coupling_incoming_carry != 0u;

    exact_wide_used_limb_counts[exact_diagonal_product_slot] =
        diagonal_used_limb_count;
    exact_wide_used_limb_counts[exact_coupling_product_slot] =
        coupling_used_limb_count;
    exact_wide_signs[exact_diagonal_product_slot] =
        diagonal_used_limb_count == 0u ? 0 : diagonal_output_sign;
    exact_wide_signs[exact_coupling_product_slot] =
        coupling_used_limb_count == 0u ? 0 : coupling_output_sign;
    return !diagonal_overflowed && !coupling_overflowed;
}

bool multiply_recurrence_products_cooperatively(
    uint current_polynomial_slot, uvec2 shifted_diagonal_raw,
    uint previous_polynomial_slot, uvec4 coupling_square) {
    const uint local_lane = gl_LocalInvocationID.x;
    const uint product_workspace_word_count =
        exact_product_count * exact_product_accumulator_count *
        exact_product_column_count;
    for (uint word_index = local_lane;
         word_index < product_workspace_word_count;
         word_index += gl_WorkGroupSize.x) {
        exact_wide_workspace[word_index] = 0u;
    }
    barrier();

    const uvec2 diagonal_magnitude = cv_i64_magnitude(shifted_diagonal_raw);
    const uint diagonal_term_count =
        exact_wide_used_limb_counts[current_polynomial_slot] * 2u;
    const uint coupling_term_count =
        exact_wide_used_limb_counts[previous_polynomial_slot] * 4u;
    const uint total_term_count = diagonal_term_count + coupling_term_count;
    for (uint flat_term_index = local_lane;
         flat_term_index < total_term_count;
         flat_term_index += gl_WorkGroupSize.x) {
        uint product_index;
        uint value_slot;
        uint factor_limb_count;
        uint relative_term_index;
        if (flat_term_index < diagonal_term_count) {
            product_index = exact_diagonal_product_index;
            value_slot = current_polynomial_slot;
            factor_limb_count = 2u;
            relative_term_index = flat_term_index;
        } else {
            product_index = exact_coupling_product_index;
            value_slot = previous_polynomial_slot;
            factor_limb_count = 4u;
            relative_term_index = flat_term_index - diagonal_term_count;
        }

        const uint value_limb_index =
            relative_term_index / factor_limb_count;
        const uint factor_limb_index =
            relative_term_index - value_limb_index * factor_limb_count;
        const uint value_limb = load_wide_limb(
            value_slot, value_limb_index);
        const uint factor_limb = product_index == exact_diagonal_product_index
            ? diagonal_magnitude[factor_limb_index]
            : coupling_square[factor_limb_index];
        if (value_limb != 0u && factor_limb != 0u) {
            uint product_high;
            uint product_low;
            umulExtended(
                value_limb, factor_limb, product_high, product_low);
            const uint product_column =
                value_limb_index + factor_limb_index;
            accumulate_exact_product_word(
                product_index, product_column, product_low);
            accumulate_exact_product_word(
                product_index, product_column + 1u, product_high);
        }
    }
    barrier();

    if (local_lane == 0u) {
        const int diagonal_sign = cv_i64_negative(shifted_diagonal_raw)
            ? -exact_wide_signs[current_polynomial_slot]
            : exact_wide_signs[current_polynomial_slot];
        if (!finalize_exact_recurrence_products(
                diagonal_sign,
                exact_wide_signs[previous_polynomial_slot])) {
            exact_phase_failed = 1u;
        }
    }
    barrier();
    return exact_phase_failed == 0u;
}

bool subtract_wide_signed(
    uint lhs_slot, uint rhs_slot, uint output_slot) {
    clear_wide_signed(output_slot);
    if (exact_wide_signs[rhs_slot] == 0) {
        copy_wide_signed(output_slot, lhs_slot);
        return true;
    }
    if (exact_wide_signs[lhs_slot] == 0) {
        copy_wide_signed(output_slot, rhs_slot);
        exact_wide_signs[output_slot] = -exact_wide_signs[output_slot];
        return true;
    }
    if (exact_wide_signs[lhs_slot] != exact_wide_signs[rhs_slot]) {
        if (!add_wide_unsigned(lhs_slot, rhs_slot, output_slot)) {
            return false;
        }
        exact_wide_signs[output_slot] = exact_wide_signs[lhs_slot];
        return true;
    }
    const int magnitude_comparison = compare_wide_unsigned(lhs_slot, rhs_slot);
    if (magnitude_comparison == 0) return true;
    if (magnitude_comparison > 0) {
        subtract_wide_unsigned(lhs_slot, rhs_slot, output_slot);
        exact_wide_signs[output_slot] = exact_wide_signs[lhs_slot];
    } else {
        subtract_wide_unsigned(rhs_slot, lhs_slot, output_slot);
        exact_wide_signs[output_slot] = -exact_wide_signs[lhs_slot];
    }
    return true;
}

uint exact_prefix_pair_word_index(
    uint buffer_index, uint element_index) {
    return 2u * (buffer_index * exact_prefix_element_count + element_index);
}

uvec2 load_exact_prefix_pair(uint buffer_index, uint element_index) {
    const uint word_index = exact_prefix_pair_word_index(
        buffer_index, element_index);
    return uvec2(
        exact_wide_workspace[word_index],
        exact_wide_workspace[word_index + 1u]);
}

void store_exact_prefix_pair(
    uint buffer_index, uint element_index, uvec2 pair_value) {
    const uint word_index = exact_prefix_pair_word_index(
        buffer_index, element_index);
    exact_wide_workspace[word_index] = pair_value.x;
    exact_wide_workspace[word_index + 1u] = pair_value.y;
}

uvec2 combine_exact_prefix_pairs(uvec2 lower_pair, uvec2 upper_pair) {
    return uvec2(
        upper_pair.x | (upper_pair.y & lower_pair.x),
        upper_pair.y & lower_pair.y);
}

void prepare_cooperative_wide_subtraction(
    uint lhs_slot, uint rhs_slot, uint output_slot) {
    const uint local_lane = gl_LocalInvocationID.x;
    uint highest_mismatch_plus_one = 0u;
    if (exact_wide_used_limb_counts[lhs_slot] ==
        exact_wide_used_limb_counts[rhs_slot]) {
        for (uint limb_index = local_lane;
             limb_index < exact_wide_used_limb_counts[lhs_slot];
             limb_index += gl_WorkGroupSize.x) {
            if (load_wide_limb(lhs_slot, limb_index) !=
                load_wide_limb(rhs_slot, limb_index)) {
                highest_mismatch_plus_one = max(
                    highest_mismatch_plus_one, limb_index + 1u);
            }
        }
    }
    exact_wide_workspace[local_lane] = highest_mismatch_plus_one;
    barrier();

    if (local_lane == 0u) {
        exact_subtract_lhs_slot = lhs_slot;
        exact_subtract_rhs_slot = rhs_slot;
        exact_subtract_output_slot = output_slot;
        exact_subtract_output_sign = 0;
        exact_prefix_final_carry = 0u;
        exact_wide_used_limb_counts[output_slot] = 0u;
        exact_wide_signs[output_slot] = 0;

        if (exact_wide_signs[rhs_slot] == 0) {
            exact_subtract_operation = exact_subtract_copy_operation;
            exact_subtract_output_sign = exact_wide_signs[lhs_slot];
        } else if (exact_wide_signs[lhs_slot] == 0) {
            exact_subtract_operation = exact_subtract_copy_operation;
            exact_subtract_lhs_slot = rhs_slot;
            exact_subtract_output_sign = -exact_wide_signs[rhs_slot];
        } else if (exact_wide_signs[lhs_slot] != exact_wide_signs[rhs_slot]) {
            exact_subtract_operation = exact_subtract_add_operation;
            exact_subtract_output_sign = exact_wide_signs[lhs_slot];
        } else {
            int magnitude_comparison = 0;
            if (exact_wide_used_limb_counts[lhs_slot] !=
                exact_wide_used_limb_counts[rhs_slot]) {
                magnitude_comparison =
                    exact_wide_used_limb_counts[lhs_slot] <
                        exact_wide_used_limb_counts[rhs_slot]
                    ? -1
                    : 1;
            } else {
                uint highest_mismatch = 0u;
                for (uint lane_index = 0u;
                     lane_index < gl_WorkGroupSize.x; ++lane_index) {
                    highest_mismatch = max(
                        highest_mismatch,
                        exact_wide_workspace[lane_index]);
                }
                if (highest_mismatch != 0u) {
                    const uint limb_index = highest_mismatch - 1u;
                    magnitude_comparison =
                        load_wide_limb(lhs_slot, limb_index) <
                            load_wide_limb(rhs_slot, limb_index)
                        ? -1
                        : 1;
                }
            }

            if (magnitude_comparison == 0) {
                exact_subtract_operation = exact_subtract_zero_operation;
            } else {
                exact_subtract_operation = exact_subtract_subtract_operation;
                if (magnitude_comparison > 0) {
                    exact_subtract_output_sign = exact_wide_signs[lhs_slot];
                } else {
                    exact_subtract_lhs_slot = rhs_slot;
                    exact_subtract_rhs_slot = lhs_slot;
                    exact_subtract_output_sign = -exact_wide_signs[lhs_slot];
                }
            }
        }
    }
    barrier();
}

void execute_cooperative_wide_prefix_operation() {
    const uint local_lane = gl_LocalInvocationID.x;
    const bool addition =
        exact_subtract_operation == exact_subtract_add_operation;

    for (uint element_index = local_lane;
         element_index < exact_prefix_element_count;
         element_index += gl_WorkGroupSize.x) {
        uvec2 prefix_pair;
        if (element_index >= characteristic_integer_limb_count) {
            prefix_pair = uvec2(0u, 1u);
        } else {
            const uint lhs_limb = element_index <
                    exact_wide_used_limb_counts[exact_subtract_lhs_slot]
                ? load_wide_limb(exact_subtract_lhs_slot, element_index)
                : 0u;
            const uint rhs_limb = element_index <
                    exact_wide_used_limb_counts[exact_subtract_rhs_slot]
                ? load_wide_limb(exact_subtract_rhs_slot, element_index)
                : 0u;
            if (addition) {
                const uint raw_sum = lhs_limb + rhs_limb;
                prefix_pair = uvec2(
                    raw_sum < lhs_limb ? 1u : 0u,
                    raw_sum == 0xffffffffu ? 1u : 0u);
            } else {
                prefix_pair = uvec2(
                    lhs_limb < rhs_limb ? 1u : 0u,
                    lhs_limb == rhs_limb ? 1u : 0u);
            }
        }
        store_exact_prefix_pair(0u, element_index, prefix_pair);
    }
    barrier();

    uint source_buffer_index = 0u;
    uint destination_buffer_index = 1u;
    for (uint prefix_distance = 1u;
         prefix_distance < exact_prefix_element_count;
         prefix_distance <<= 1u) {
        for (uint element_index = local_lane;
             element_index < exact_prefix_element_count;
             element_index += gl_WorkGroupSize.x) {
            uvec2 combined_pair = load_exact_prefix_pair(
                source_buffer_index, element_index);
            if (element_index >= prefix_distance) {
                combined_pair = combine_exact_prefix_pairs(
                    load_exact_prefix_pair(
                        source_buffer_index,
                        element_index - prefix_distance),
                    combined_pair);
            }
            store_exact_prefix_pair(
                destination_buffer_index, element_index, combined_pair);
        }
        barrier();
        const uint prior_source_buffer_index = source_buffer_index;
        source_buffer_index = destination_buffer_index;
        destination_buffer_index = prior_source_buffer_index;
    }

    for (uint element_index = local_lane;
         element_index < characteristic_integer_limb_count;
         element_index += gl_WorkGroupSize.x) {
        const uint incoming_carry = element_index == 0u
            ? 0u
            : load_exact_prefix_pair(
                source_buffer_index, element_index - 1u).x;
        const uint lhs_limb = element_index <
                exact_wide_used_limb_counts[exact_subtract_lhs_slot]
            ? load_wide_limb(exact_subtract_lhs_slot, element_index)
            : 0u;
        const uint rhs_limb = element_index <
                exact_wide_used_limb_counts[exact_subtract_rhs_slot]
            ? load_wide_limb(exact_subtract_rhs_slot, element_index)
            : 0u;
        const uint raw_result = addition
            ? lhs_limb + rhs_limb
            : lhs_limb - rhs_limb;
        store_wide_limb(
            exact_subtract_output_slot, element_index,
            addition
                ? raw_result + incoming_carry
                : raw_result - incoming_carry);
    }
    if (local_lane == 0u) {
        exact_prefix_final_carry = load_exact_prefix_pair(
            source_buffer_index, exact_prefix_element_count - 1u).x;
    }
    barrier();
}

void normalize_wide_unsigned_cooperatively(uint slot) {
    const uint local_lane = gl_LocalInvocationID.x;
    uint highest_nonzero_limb_plus_one = 0u;
    for (uint limb_index = local_lane;
         limb_index < characteristic_integer_limb_count;
         limb_index += gl_WorkGroupSize.x) {
        if (load_wide_limb(slot, limb_index) != 0u) {
            highest_nonzero_limb_plus_one = max(
                highest_nonzero_limb_plus_one, limb_index + 1u);
        }
    }
    exact_wide_workspace[local_lane] = highest_nonzero_limb_plus_one;
    barrier();
    if (local_lane == 0u) {
        uint used_limb_count = 0u;
        for (uint lane_index = 0u;
             lane_index < gl_WorkGroupSize.x; ++lane_index) {
            used_limb_count = max(
                used_limb_count, exact_wide_workspace[lane_index]);
        }
        exact_wide_used_limb_counts[slot] = used_limb_count;
    }
    barrier();
}

bool subtract_wide_signed_cooperatively(
    uint lhs_slot, uint rhs_slot, uint output_slot) {
    const uint local_lane = gl_LocalInvocationID.x;
    if (exact_phase_failed == 0u) {
        prepare_cooperative_wide_subtraction(lhs_slot, rhs_slot, output_slot);
    }
    if (exact_phase_failed != 0u) return false;

    if (exact_subtract_operation == exact_subtract_add_operation ||
        exact_subtract_operation == exact_subtract_subtract_operation) {
        execute_cooperative_wide_prefix_operation();
    } else {
        for (uint limb_index = local_lane;
             limb_index < characteristic_integer_limb_count;
             limb_index += gl_WorkGroupSize.x) {
            const uint output_limb =
                exact_subtract_operation == exact_subtract_copy_operation
                ? load_wide_limb(exact_subtract_lhs_slot, limb_index)
                : 0u;
            store_wide_limb(output_slot, limb_index, output_limb);
        }
        barrier();
    }

    normalize_wide_unsigned_cooperatively(output_slot);

    if (local_lane == 0u) {
        if (
            exact_subtract_operation == exact_subtract_add_operation &&
            exact_prefix_final_carry != 0u) {
            exact_phase_failed = 1u;
        } else {
            exact_wide_signs[output_slot] =
                exact_wide_used_limb_counts[output_slot] == 0u
                ? 0
                : exact_subtract_output_sign;
        }
    }
    barrier();
    return exact_phase_failed == 0u;
}

bool subtract_i64_checked(uvec2 lhs, uvec2 rhs, out uvec2 output_value) {
    output_value = cv_u64_subtract(lhs, rhs);
    const bool lhs_negative = cv_i64_negative(lhs);
    const bool rhs_negative = cv_i64_negative(rhs);
    const bool output_negative = cv_i64_negative(output_value);
    return lhs_negative == rhs_negative || output_negative == lhs_negative;
}

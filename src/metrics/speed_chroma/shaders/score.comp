uint scratch_stream_stride() {
    return block_statistics_logical_offset +
        score_scratch_elements_per_block * parameters.block_count;
}

uint current_batch_frame() {
#if CROSSVMAF_SPEED_CHROMA_STREAMING_WAVE
    return wave_slots.entries[gl_WorkGroupID.y].x;
#else
    return 0u;
#endif
}

uint result_packet_index(uint logical_index) {
    const uint frame_stride = parameters.result_frame_stride_elements == 0u
        ? score_result_element_count
        : parameters.result_frame_stride_elements;
    return current_batch_frame() * frame_stride +
        logical_index;
}

uint stream_state_index_for(uint stream) {
    return result_packet_index(stream_state_result_offset) + stream;
}

uint scratch_index_for_stream(uint stream, uint logical_index) {
    const uint default_frame_stride = 4u * scratch_stream_stride();
    const uint frame_stride = parameters.scratch_frame_stride_elements == 0u
        ? default_frame_stride
        : parameters.scratch_frame_stride_elements;
    return current_batch_frame() * frame_stride +
        stream * scratch_stream_stride() + logical_index;
}

uint current_parameter_stream() {
    return gl_WorkGroupID.z;
}

uint current_scratch_index(uint logical_index) {
    return scratch_index_for_stream(current_parameter_stream(), logical_index);
}

uint current_stream_state_index() {
    return stream_state_index_for(current_parameter_stream());
}

uint matrix_index(uint base, uint row, uint column) {
    return base + row * element_count + column;
}

uint reflector_tail_offset(uint reflector_index) {
    return reflector_index * (47u - reflector_index) / 2u;
}

uint entropy_logical_offset() {

uvec2 load_quantized_feature_sample(uint index) {
    const uint stream_element_count =
        parameters.operating_width * parameters.operating_height;
    const uint default_frame_stride = 4u * stream_element_count;
    const uint frame_stride = parameters.highpass_frame_stride_elements == 0u
        ? default_frame_stride
        : parameters.highpass_frame_stride_elements;
    return highpass_samples.values[
        current_batch_frame() * frame_stride +
        current_parameter_stream() * stream_element_count + index];
}

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 1
bool initialize_grouped_mean() {
    const uint local_lane = gl_LocalInvocationID.x;
    const uint mean_index = gl_WorkGroupID.x;
    const uint start_row = mean_index / block_size;
    const uint start_column = mean_index - start_row * block_size;
    if (local_lane == 0u) means_exact_failure = 0u;
    barrier();

    uvec4 exact_row_sum = uvec4(0u);
    bool accumulation_succeeded = true;
    for (uint row = local_lane; row < parameters.submatrix_height;
         row += gl_WorkGroupSize.x) {
        for (uint column = 0u; column < parameters.submatrix_width;
             ++column) {
            const uint source =
                (start_row + row) * parameters.operating_width +
                start_column + column;
            if (!cv_i128_add_i64_checked(
                    exact_row_sum,
                    load_quantized_feature_sample(source))) {
                accumulation_succeeded = false;
                break;
            }
        }
        if (!accumulation_succeeded) break;
    }
    means_exact_row_sums[local_lane] = exact_row_sum;
    if (!accumulation_succeeded) atomicOr(means_exact_failure, 1u);
    barrier();

    for (uint stride = gl_WorkGroupSize.x >> 1u; stride > 0u;
         stride >>= 1u) {
        if (local_lane < stride && means_exact_failure == 0u) {
            uvec4 reduced_sum;
            if (cv_i128_add_checked(
                    means_exact_row_sums[local_lane],
                    means_exact_row_sums[local_lane + stride],
                    reduced_sum)) {
                means_exact_row_sums[local_lane] = reduced_sum;
            } else {
                atomicOr(means_exact_failure, 1u);
            }
        }
        barrier();
    }

    if (local_lane == 0u && means_exact_failure == 0u) {
        uvec2 rounded_mean;
        if (cv_i128_divide_i64_by_u32_prepared_rne_checked(
                means_exact_row_sums[0],
                parameters.covariance_sample_divider, rounded_mean)) {
            scratch.values[current_scratch_index(
                means_logical_offset + mean_index)] =
                    cv_binary32_quantize(rounded_mean);
        } else {
            means_exact_failure = 1u;
        }
    }
    barrier();
    return means_exact_failure == 0u;
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 5
const uint covariance_sample_lane_count = 64u;
const uint covariance_entries_per_group = 4u;
const uint covariance_entry_batch_count = 7u;

void accumulate_covariance_sample(
    uint y_index, bool entry_is_valid, uint row, uint column,
    uvec2 x, uvec2 y_mean, inout uvec4 sum) {
    if (!entry_is_valid) return;
    const uint y_row = y_index / block_size;
    const uint y_column = y_index - y_row * block_size;
    const uint y_source =
        (y_row + row) * parameters.operating_width + y_column + column;
    const uvec2 y = cv_q32_subtract_saturating(
        load_quantized_feature_sample(y_source), y_mean);
    sum = cv_u128_add(sum, cv_i64_multiply_wide(x, y));
}

void store_covariance_entry(
    uint x_index, uint y_index, bool entry_is_valid, uvec4 sum) {
    if (!entry_is_valid) return;
    uvec2 covariance;
    if (!cv_i128_divide_q64_by_u32_prepared_rne(
            sum, parameters.covariance_sample_divider, covariance)) {
        atomicOr(results.values[current_stream_state_index()].x, 4u);
        return;
    }
    covariance = cv_binary32_quantize(covariance);
    const uint covariance_base = current_scratch_index(
        covariance_logical_offset);
    scratch.values[matrix_index(covariance_base, x_index, y_index)] =
        covariance;
    scratch.values[matrix_index(covariance_base, y_index, x_index)] =
        covariance;
}

#include "covariance.glsl"

void initialize_covariance_group(uint group_index) {
    const uint x_index = group_index / covariance_entry_batch_count;
    const uint entry_batch =
        group_index - x_index * covariance_entry_batch_count;
    const uint first_y_index = entry_batch * covariance_entries_per_group;
    if (x_index >= element_count || first_y_index > x_index) return;

    const uint local_lane = gl_LocalInvocationID.x;
    const uint y_index_0 = first_y_index;
    const uint y_index_1 = first_y_index + 1u;
    const uint y_index_2 = first_y_index + 2u;
    const uint y_index_3 = first_y_index + 3u;
    const bool entry_0_is_valid = y_index_0 <= x_index;
    const bool entry_1_is_valid = y_index_1 <= x_index;
    const bool entry_2_is_valid = y_index_2 <= x_index;
    const bool entry_3_is_valid = y_index_3 <= x_index;

    const uvec2 x_mean = scratch.values[current_scratch_index(
        means_logical_offset + x_index)];
    uvec2 y_mean_0 = q_zero;
    uvec2 y_mean_1 = q_zero;
    uvec2 y_mean_2 = q_zero;
    uvec2 y_mean_3 = q_zero;
    if (entry_0_is_valid) {
        y_mean_0 = scratch.values[current_scratch_index(
            means_logical_offset + y_index_0)];
    }
    if (entry_1_is_valid) {
        y_mean_1 = scratch.values[current_scratch_index(
            means_logical_offset + y_index_1)];
    }
    if (entry_2_is_valid) {
        y_mean_2 = scratch.values[current_scratch_index(
            means_logical_offset + y_index_2)];
    }
    if (entry_3_is_valid) {
        y_mean_3 = scratch.values[current_scratch_index(
            means_logical_offset + y_index_3)];
    }

    const uint x_row = x_index / block_size;
    const uint x_column = x_index - x_row * block_size;
    uvec4 sum_0 = uvec4(0u);
    uvec4 sum_1 = uvec4(0u);
    uvec4 sum_2 = uvec4(0u);
    uvec4 sum_3 = uvec4(0u);
    for (uint sample_index = local_lane;
         sample_index < parameters.covariance_sample_count;
         sample_index += covariance_sample_lane_count) {
        const uint row = sample_index / parameters.submatrix_width;
        const uint column =
            sample_index - row * parameters.submatrix_width;
        const uint x_source =
            (x_row + row) * parameters.operating_width + x_column + column;
        const uvec2 x = cv_q32_subtract_saturating(
            load_quantized_feature_sample(x_source), x_mean);
        accumulate_covariance_sample(
            y_index_0, entry_0_is_valid, row, column,
            x, y_mean_0, sum_0);
        accumulate_covariance_sample(
            y_index_1, entry_1_is_valid, row, column,
            x, y_mean_1, sum_1);
        accumulate_covariance_sample(
            y_index_2, entry_2_is_valid, row, column,
            x, y_mean_2, sum_2);
        accumulate_covariance_sample(
            y_index_3, entry_3_is_valid, row, column,
            x, y_mean_3, sum_3);
    }

    covariance_partials[local_lane] = sum_0;
    covariance_partials[covariance_sample_lane_count + local_lane] = sum_1;
    covariance_partials[2u * covariance_sample_lane_count + local_lane] =
        sum_2;
    covariance_partials[3u * covariance_sample_lane_count + local_lane] =
        sum_3;
    barrier();
    for (uint stride = covariance_sample_lane_count >> 1u; stride > 0u;
         stride >>= 1u) {
        if (local_lane < stride) {
            covariance_partials[local_lane] = cv_u128_add(
                covariance_partials[local_lane],
                covariance_partials[local_lane + stride]);
            covariance_partials[
                covariance_sample_lane_count + local_lane] = cv_u128_add(
                    covariance_partials[
                        covariance_sample_lane_count + local_lane],
                    covariance_partials[
                        covariance_sample_lane_count + local_lane + stride]);
            covariance_partials[
                2u * covariance_sample_lane_count + local_lane] =
                    cv_u128_add(
                        covariance_partials[
                            2u * covariance_sample_lane_count + local_lane],
                        covariance_partials[
                            2u * covariance_sample_lane_count +
                            local_lane + stride]);
            covariance_partials[
                3u * covariance_sample_lane_count + local_lane] =
                    cv_u128_add(
                        covariance_partials[
                            3u * covariance_sample_lane_count + local_lane],
                        covariance_partials[
                            3u * covariance_sample_lane_count +
                            local_lane + stride]);
        }
        barrier();
    }
    if (local_lane != 0u) return;

    store_covariance_entry(
        x_index, y_index_0, entry_0_is_valid, covariance_partials[0]);
    store_covariance_entry(
        x_index, y_index_1, entry_1_is_valid,
        covariance_partials[covariance_sample_lane_count]);
    store_covariance_entry(
        x_index, y_index_2, entry_2_is_valid,
        covariance_partials[2u * covariance_sample_lane_count]);
    store_covariance_entry(
        x_index, y_index_3, entry_3_is_valid,
        covariance_partials[3u * covariance_sample_lane_count]);
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 2
const uint compact_control_inactive = 0u;
const uint compact_control_active = 1u;

int compact_matrix_normalization_exponent() {
    uvec2 largest_magnitude = uvec2(0u);
    for (uint index = 0u; index < matrix_count; ++index) {
        const uvec2 magnitude = cv_i64_magnitude(compact_matrix[index]);
        if (cv_u64_less(largest_magnitude, magnitude)) {
            largest_magnitude = magnitude;
        }
    }
    return q_normalization_exponent_from_magnitude(largest_magnitude);
}

bool prepare_compact_householder_reflector(
    uint column, out uvec2 tau, out uvec2 tail_scale) {
    const uint leading_row = column + 1u;
    uvec4 square_sum = uvec4(0u);
    for (uint row = leading_row + 1u; row < element_count; ++row) {
        cv_q48_norm_accumulate(
            square_sum,
            compact_matrix[matrix_index(0u, row, column)]);
    }
    const uvec2 tail_norm = cv_q48_norm_finalize_binary32(square_sum);
    if (cv_u64_is_zero(tail_norm)) {
        tau = l_zero;
        tail_scale = l_zero;
        return true;
    }

    const uvec2 alpha =
        compact_matrix[matrix_index(0u, leading_row, column)];
    const uvec2 hypotenuse = cv_q48_norm2_binary32(alpha, tail_norm);
    const uvec2 beta = cv_i64_negative(alpha)
        ? hypotenuse
        : l_negate(hypotenuse);
    if (!l_divide(l_subtract(beta, alpha), beta, tau)) return false;
    tail_scale = l_subtract(alpha, beta);
    if (cv_u64_is_zero(tail_scale)) return false;

    compact_matrix[matrix_index(0u, leading_row, column)] = beta;
    return true;
}

void reduce_to_compact_tridiagonal_cooperatively() {
    const uint local_lane = gl_LocalInvocationID.x;
    const uint covariance_base = current_scratch_index(
        covariance_logical_offset);
    const uint tau_base = current_scratch_index(
        reflector_tau_logical_offset);
    const uint tails_base = current_scratch_index(
        reflector_tails_logical_offset);

    if (local_lane == 0u) {
        compact_phase_failed = current_parameter_stream() >= 4u ? 1u : 0u;
        compact_control = compact_control_inactive;
        if (compact_phase_failed == 0u) {
            const uint state_index = current_stream_state_index();
            if ((results.values[state_index].x &
                    stream_arithmetic_failure_flag) != 0u) {
                compact_phase_failed = 1u;
            } else {
                scratch.values[current_scratch_index(
                    factor_liveness_dimensions_logical_offset)] = uvec2(
                    parameters.submatrix_width,
                    parameters.covariance_sample_count);
                scratch.values[current_scratch_index(
                    factor_liveness_shape_logical_offset)] = uvec2(
                    parameters.operating_width, parameters.block_count);
            }
        }
    }
    barrier();

    if (compact_phase_failed == 0u) {
        for (uint index = local_lane; index < matrix_count;
             index += gl_WorkGroupSize.x) {
            compact_matrix[index] = scratch.values[covariance_base + index];
        }
    }
    barrier();

    if (local_lane == 0u) {
        compact_matrix_exponent = 0;
        if (compact_phase_failed == 0u) {
            compact_matrix_exponent = compact_matrix_normalization_exponent();
            scratch.values[current_scratch_index(
                matrix_exponent_logical_offset)] =
                uvec2(uint(compact_matrix_exponent), 0u);
        }
    }
    barrier();

    if (compact_phase_failed == 0u) {
        for (uint index = local_lane; index < matrix_count;
             index += gl_WorkGroupSize.x) {
            uvec2 converted_value;
            if (!l_convert_public_with_exponent(
                    compact_matrix[index], compact_matrix_exponent,
                    converted_value)) {
                atomicOr(compact_phase_failed, 1u);
            } else {
                compact_matrix[index] = converted_value;
            }
        }
    }
    barrier();

    for (uint column = 0u; column < reflector_count; ++column) {
        const uint leading_row = column + 1u;
        if (local_lane == 0u) {
            compact_control = compact_control_inactive;
            compact_current_tau = l_zero;
            compact_tail_scale = l_zero;
            if (compact_phase_failed == 0u) {
                if (!prepare_compact_householder_reflector(
                        column, compact_current_tau, compact_tail_scale)) {
                    compact_phase_failed = 1u;
                } else {
                    scratch.values[tau_base + column] = compact_current_tau;
                    if (!cv_u64_is_zero(compact_current_tau)) {
                        compact_control = compact_control_active;
                    }
                }
            }
        }
        barrier();

        if (local_lane < element_count) {
            const uint row = local_lane;
            compact_reflector[row] = l_zero;
            if (compact_phase_failed == 0u && row == leading_row &&
                compact_control == compact_control_active) {
                compact_reflector[row] = l_one;
            }
            if (compact_phase_failed == 0u && row > leading_row) {
                const uint matrix_cell = matrix_index(0u, row, column);
                if (compact_control == compact_control_active) {
                    uvec2 quotient;
                    if (!l_divide(
                            compact_matrix[matrix_cell], compact_tail_scale,
                            quotient)) {
                        atomicOr(compact_phase_failed, 1u);
                    } else {
                        compact_matrix[matrix_cell] = quotient;
                        compact_reflector[row] = quotient;
                    }
                }
                const uint tail_offset = reflector_tail_offset(column);
                scratch.values[
                    tails_base + tail_offset + row - leading_row - 1u] =
                    compact_matrix[matrix_cell];
            }
        }
        barrier();

        if (local_lane < element_count) {
            const uint row = local_lane;
            compact_product[row] = l_zero;
            compact_dot_terms[row] = l_zero;
            if (compact_phase_failed == 0u &&
                compact_control == compact_control_active &&
                row >= leading_row) {
                for (uint inner = leading_row; inner < element_count; ++inner) {
                    const uvec2 matrix_vector = l_multiply(
                        compact_matrix[matrix_index(0u, row, inner)],
                        compact_reflector[inner]);
                    compact_product[row] = l_add(
                        compact_product[row],
                        l_multiply(compact_current_tau, matrix_vector));
                }
                compact_dot_terms[row] = l_multiply(
                    compact_product[row], compact_reflector[row]);
            }
        }
        barrier();

        if (local_lane == 0u) {
            compact_correction_scale = l_zero;
            if (compact_phase_failed == 0u &&
                compact_control == compact_control_active) {
                uvec2 dot_product = l_zero;
                for (uint row = leading_row; row < element_count; ++row) {
                    dot_product = l_add(
                        dot_product, compact_dot_terms[row]);
                }
                compact_correction_scale = l_negate(
                    l_multiply(
                        l_multiply(l_half, compact_current_tau), dot_product));
            }
        }
        barrier();

        if (local_lane < element_count) {
            const uint row = local_lane;
            if (compact_phase_failed == 0u &&
                compact_control == compact_control_active &&
                row >= leading_row) {
                compact_product[row] = l_add(
                    compact_product[row], l_multiply(
                        compact_correction_scale, compact_reflector[row]));
            }
        }
        barrier();

        if (compact_phase_failed == 0u &&
            compact_control == compact_control_active) {
            for (uint cell = local_lane; cell < matrix_count;
                 cell += gl_WorkGroupSize.x) {
                const uint row = cell / element_count;
                const uint inner = cell - row * element_count;
                if (row >= leading_row && inner >= leading_row) {
                    const uvec2 symmetric_correction = l_add(
                        l_multiply(
                            compact_product[row], compact_reflector[inner]),
                        l_multiply(
                            compact_reflector[row], compact_product[inner]));
                    compact_matrix[cell] = l_subtract(
                        compact_matrix[cell], symmetric_correction);
                }
            }
        }
        barrier();
    }

    if (compact_phase_failed == 0u) {
        const uint diagonal_base = current_scratch_index(
            diagonal_logical_offset);
        const uint subdiagonal_base = current_scratch_index(
            subdiagonal_logical_offset);
        for (uint index = local_lane; index < matrix_count;
             index += gl_WorkGroupSize.x) {
            scratch.values[covariance_base + index] = compact_matrix[index];
        }
        if (local_lane < element_count) {
            scratch.values[diagonal_base + local_lane] =
                compact_matrix[matrix_index(0u, local_lane, local_lane)];
            if (local_lane + 1u < element_count) {
                scratch.values[subdiagonal_base + local_lane] =
                    compact_matrix[
                        matrix_index(0u, local_lane + 1u, local_lane)];
            }
        }
    }
    barrier();

    if (local_lane == 0u && compact_phase_failed == 0u) {
        const int matrix_exponent = int(scratch.values[
            current_scratch_index(matrix_exponent_logical_offset)].x);
        const uint diagnostic_diagonal_base = current_scratch_index(
            diagnostic_diagonal_logical_offset);
        const uint diagnostic_subdiagonal_base = current_scratch_index(
            diagnostic_subdiagonal_logical_offset);
        for (uint index = 0u; index < element_count; ++index) {
            if (!l_to_q32_scaled_checked(
                    compact_matrix[matrix_index(0u, index, index)],
                    -matrix_exponent,
                    scratch.values[diagnostic_diagonal_base + index])) {
                compact_phase_failed = 1u;
                break;
            }
        }
        if (compact_phase_failed == 0u) {
            for (uint index = 0u; index + 1u < element_count; ++index) {
                if (!l_to_q32_scaled_checked(
                        compact_matrix[matrix_index(0u, index + 1u, index)],
                        -matrix_exponent,
                        scratch.values[
                            diagnostic_subdiagonal_base + index])) {
                    compact_phase_failed = 1u;
                    break;
                }
            }
        }
    }
    barrier();

    if (local_lane == 0u && current_parameter_stream() < 4u &&
        compact_phase_failed != 0u) {
        results.values[current_stream_state_index()].x |=
            stream_arithmetic_failure_flag;
    }
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 6
bool classify_covariance_regularity_cooperatively(
    int matrix_exponent, out uint negative_pivot_count,
    out uint stabilized_pivot_count) {
    const uint local_lane = gl_LocalInvocationID.x;
    const uint diagonal_base = current_scratch_index(
        diagonal_logical_offset);
    const uint subdiagonal_base = current_scratch_index(
        subdiagonal_logical_offset);
    uvec2 shifted_epsilon;
    if (!l_convert_public_with_exponent(
            q_public_epsilon, matrix_exponent, shifted_epsilon)) {
        return false;
    }

    uint sign_variation_count = 0u;
    uint exact_zero_count = 0u;
    uint block_start = 0u;
    while (block_start < element_count) {
        uint block_end = block_start;
        while (block_end + 1u < element_count &&
               !cv_u64_is_zero(scratch.values[
                   subdiagonal_base + block_end])) {
            ++block_end;
        }

        uint previous_polynomial_slot = exact_polynomial_previous_slot;
        uint current_polynomial_slot = exact_polynomial_current_slot;
        uint next_polynomial_slot = exact_polynomial_next_slot;
        initialize_polynomial_pair_cooperatively(
            previous_polynomial_slot, current_polynomial_slot);
        int previous_nonzero_sign = 1;

        for (uint index = block_start; index <= block_end; ++index) {
            uvec2 shifted_diagonal_raw;
            if (!subtract_i64_checked(
                    scratch.values[diagonal_base + index],
                    shifted_epsilon, shifted_diagonal_raw)) {
                return false;
            }

            if (index == block_start) {
                make_wide_signed_cooperatively(
                    shifted_diagonal_raw, next_polynomial_slot);
                // Preserve p0, then switch two slots for the newly written p1.
                const uint invalidated_current_slot = current_polynomial_slot;
                current_polynomial_slot = next_polynomial_slot;
                next_polynomial_slot = invalidated_current_slot;
            } else {
                const uvec2 coupling_magnitude = cv_i64_magnitude(
                    scratch.values[subdiagonal_base + index - 1u]);
                const uvec4 coupling_square = cv_u64_multiply(
                    coupling_magnitude, coupling_magnitude);
                if (!multiply_recurrence_products_cooperatively(
                        current_polynomial_slot, shifted_diagonal_raw,
                        previous_polynomial_slot, coupling_square)) {
                    return false;
                }
                if (!subtract_wide_signed_cooperatively(
                        exact_diagonal_product_slot,
                        exact_coupling_product_slot,
                        next_polynomial_slot)) {
                    return false;
                }
                const uint invalidated_previous_slot =
                    previous_polynomial_slot;
                previous_polynomial_slot = current_polynomial_slot;
                current_polynomial_slot = next_polynomial_slot;
                next_polynomial_slot = invalidated_previous_slot;
            }

            if (local_lane == 0u) {
                if (exact_wide_signs[current_polynomial_slot] == 0) {
                    ++exact_zero_count;
                } else {
                    if (exact_wide_signs[current_polynomial_slot] !=
                        previous_nonzero_sign) {
                        ++sign_variation_count;
                    }
                    previous_nonzero_sign =
                        exact_wide_signs[current_polynomial_slot];
                }
            }
        }
        block_start = block_end + 1u;
    }
    if (local_lane == 0u) {
        negative_pivot_count = sign_variation_count;
        stabilized_pivot_count = exact_zero_count;
    }
    return true;
}
#endif

bool factor_positive_definite_tridiagonal() {
    const uint diagonal_base = current_scratch_index(
        diagonal_logical_offset);
    const uint subdiagonal_base = current_scratch_index(
        subdiagonal_logical_offset);
    const uint pivots_base = current_scratch_index(
        ldl_pivots_logical_offset);
    const uint multipliers_base = current_scratch_index(
        ldl_multipliers_logical_offset);

    scratch.values[pivots_base] = scratch.values[diagonal_base];
    if (!l_less(l_zero, scratch.values[pivots_base])) return false;
    for (uint index = 0u; index + 1u < element_count; ++index) {
        uvec2 multiplier;
        if (!l_divide(
                scratch.values[subdiagonal_base + index],
                scratch.values[pivots_base + index], multiplier)) {
            return false;
        }
        scratch.values[multipliers_base + index] = multiplier;
        scratch.values[pivots_base + index + 1u] = l_subtract(
            scratch.values[diagonal_base + index + 1u],
            l_multiply(
                multiplier, scratch.values[subdiagonal_base + index]));
        if (!l_less(l_zero, scratch.values[pivots_base + index + 1u])) {
            return false;
        }
    }
    return true;
}

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 6
bool finish_compact_tridiagonal_factorization(
    uint negative_pivot_count, uint stabilized_pivot_count) {
    const uint state_index = current_stream_state_index();
    scratch.values[current_scratch_index(regularity_metadata_logical_offset)] =
        uvec2(negative_pivot_count, stabilized_pivot_count);
    const bool singular = negative_pivot_count != 0u;
    if (!singular && !factor_positive_definite_tridiagonal()) return false;

    const uint prior_flags = results.values[state_index].x;
    results.values[state_index] =
        uvec2(prior_flags | (singular ? stream_singular_flag : 0u), 0u);
    return true;
}

void classify_and_factor_compact_tridiagonal_cooperatively() {
    const uint local_lane = gl_LocalInvocationID.x;
    for (uint flat_limb_index = local_lane;
         flat_limb_index <
            characteristic_integer_limb_count * exact_wide_slot_count;
         flat_limb_index += gl_WorkGroupSize.x) {
        exact_wide_limbs[flat_limb_index] = 0u;
    }
    if (local_lane < exact_wide_slot_count) {
        exact_wide_used_limb_counts[local_lane] = 0u;
        exact_wide_signs[local_lane] = 0;
    }
    if (local_lane == 0u) {
        exact_phase_failed = current_parameter_stream() >= 4u ? 1u : 0u;
    }
    barrier();

    if (local_lane == 0u && exact_phase_failed == 0u) {
        const uint state_index = current_stream_state_index();
        if ((results.values[state_index].x &
                stream_arithmetic_failure_flag) != 0u) {
            exact_phase_failed = 1u;
        } else {
            // Keep the exact recurrence inside the liveness workaround after
            // the production dispatch split.
            scratch.values[current_scratch_index(
                factor_liveness_dimensions_logical_offset)] = uvec2(
                parameters.submatrix_width,
                parameters.covariance_sample_count);
            scratch.values[current_scratch_index(
                factor_liveness_shape_logical_offset)] = uvec2(
                parameters.operating_width, parameters.block_count);
        }
    }
    barrier();

    if (exact_phase_failed == 0u) {
        const int matrix_exponent = int(scratch.values[
            current_scratch_index(matrix_exponent_logical_offset)].x);
        uint negative_pivot_count = 0u;
        uint stabilized_pivot_count = 0u;
        const bool classification_succeeded =
            classify_covariance_regularity_cooperatively(
                matrix_exponent, negative_pivot_count,
                stabilized_pivot_count);
        if (local_lane == 0u) {
            const uint state_index = current_stream_state_index();
            if (!classification_succeeded ||
                !finish_compact_tridiagonal_factorization(
                    negative_pivot_count, stabilized_pivot_count)) {
                results.values[state_index].x |=
                    stream_arithmetic_failure_flag;
                exact_phase_failed = 1u;
            }
        }
    }
    barrier();
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 3
void transform_right_hand_side_cooperatively(uint block) {
    const uint lane = gl_LocalInvocationID.x;
    if (lane == 0u) {
        uvec2 largest_right_hand_side_magnitude = q_zero;
        for (uint row = 0u; row < element_count; ++row) {
            const uint start_row = row / block_size;
            const uint start_column = row - start_row * block_size;
            const uint block_row = block / parameters.blocks_horizontal;
            const uint block_column =
                block - block_row * parameters.blocks_horizontal;
            const uint source_row = start_row + block_row * block_size;
            const uint source_column =
                start_column + block_column * block_size;
            block_transformed_values[row] = load_quantized_feature_sample(
                source_row * parameters.operating_width + source_column);
            const uvec2 magnitude = cv_i64_magnitude(
                block_transformed_values[row]);
            if (cv_u64_less(largest_right_hand_side_magnitude, magnitude)) {
                largest_right_hand_side_magnitude = magnitude;
            }
        }
        block_right_hand_side_exponent =
            q_normalization_exponent_from_magnitude(
                largest_right_hand_side_magnitude) - 16;
        for (uint row = 0u; row < element_count; ++row) {
            const uvec2 public_value = block_transformed_values[row];
            if (!l_convert_public_with_exponent(
                    public_value, block_right_hand_side_exponent,
                    block_transformed_values[row])) {
                block_phase_failed = 1u;
                break;
            }
        }
    }
    barrier();

    const uint tau_base = current_scratch_index(
        reflector_tau_logical_offset);
    const uint tails_base = current_scratch_index(
        reflector_tails_logical_offset);
    for (uint reflector_index = 0u;
         reflector_index < reflector_count; ++reflector_index) {
        const uint leading_row = reflector_index + 1u;
        const uint tail_offset = reflector_tail_offset(reflector_index);
        const uvec2 tau = scratch.values[tau_base + reflector_index];
        const bool reflector_is_active = !cv_u64_is_zero(tau);
        if (block_phase_failed == 0u && reflector_is_active) {
            if (lane == 0u) {
                block_phase_values[0] =
                    block_transformed_values[leading_row];
            } else {
                const uint product_row = leading_row + lane;
                if (product_row < element_count) {
                    const uvec2 tail = scratch.values[
                        tails_base + tail_offset + lane - 1u];
                    block_phase_values[lane] = l_multiply(
                        tail, block_transformed_values[product_row]);
                }
            }
        }
        barrier();

        if (lane == 0u && block_phase_failed == 0u &&
            reflector_is_active) {
            uvec2 dot_product = block_phase_values[0];
            const uint product_count = element_count - leading_row;
            for (uint product_index = 1u;
                 product_index < product_count; ++product_index) {
                dot_product = l_add(
                    dot_product, block_phase_values[product_index]);
            }
            block_reflector_scaled_dot = l_multiply(tau, dot_product);
        }
        barrier();

        const uint row = leading_row + lane;
        if (block_phase_failed == 0u && reflector_is_active &&
            row < element_count) {
            if (lane == 0u) {
                block_transformed_values[row] = l_subtract(
                    block_transformed_values[row],
                    block_reflector_scaled_dot);
            } else {
                const uvec2 tail = scratch.values[
                    tails_base + tail_offset + lane - 1u];
                block_transformed_values[row] = l_subtract(
                    block_transformed_values[row],
                    l_multiply(tail, block_reflector_scaled_dot));
            }
        }
        barrier();
    }
}
#endif

bool logarithm_of_positive_value(uvec2 value, out uvec2 logarithm) {
    if (!l_less(l_zero, value)) return false;
    const int value_exponent = l_value_normalization_exponent(value);
    const uvec2 normalized = l_scale(value, value_exponent);
    uvec2 normalized_public;
    if (!l_to_q32_scaled_checked(normalized, 0, normalized_public)) {
        return false;
    }
    uvec2 normalized_logarithm;
    if (!q_log2(normalized_public, normalized_logarithm)) {
        return false;
    }
    logarithm = q_subtract(
        normalized_logarithm, q_from_int(value_exponent));
    return true;
}

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 3
void publish_transformed_right_hand_side(uint block) {
    const uint lane = gl_LocalInvocationID.x;
    if (lane == 0u) block_phase_failed = 0u;
    barrier();

    const bool singular =
        (results.values[current_stream_state_index()].x &
            stream_singular_flag) != 0u;
    if (!singular) {
        transform_right_hand_side_cooperatively(block);
    }
    barrier();

    if (!singular && block_phase_failed == 0u) {
        const uint intermediate_base = current_scratch_index(
            block_intermediate_base(block));
        if (lane < element_count) {
            scratch.values[intermediate_base + lane] =
                block_transformed_values[lane];
        }
        if (lane == 0u) {
            scratch.values[intermediate_base + element_count] =
                uvec2(uint(block_right_hand_side_exponent), 0u);
        }
    }
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 7
bool compute_inverse_quadratic_form_scalar(
    uint block, out uvec2 variance) {
    const bool singular =
        (results.values[current_stream_state_index()].x &
            stream_singular_flag) != 0u;
    if (singular) {
        variance = q_zero;
        return true;
    }

    const uint intermediate_base = current_scratch_index(
        block_intermediate_base(block));
    const int right_hand_side_exponent = int(
        scratch.values[intermediate_base + element_count].x);
    const uint multipliers_base = current_scratch_index(
        ldl_multipliers_logical_offset);
    const uint pivots_base = current_scratch_index(
        ldl_pivots_logical_offset);

    uvec2 quadratic_form = l_zero;
    uvec2 previous_forward_value = scratch.values[intermediate_base];
    uvec2 term;
    if (!l_divide(
            l_multiply(previous_forward_value, previous_forward_value),
            scratch.values[pivots_base], term)) {
        return false;
    }
    quadratic_form = l_add(quadratic_form, term);

    for (uint row = 1u; row < element_count; ++row) {
        const uvec2 current_forward_value = l_subtract(
            scratch.values[intermediate_base + row],
            l_multiply(
                scratch.values[multipliers_base + row - 1u],
                previous_forward_value));
        if (!l_divide(
                l_multiply(
                    current_forward_value, current_forward_value),
                scratch.values[pivots_base + row], term)) {
            return false;
        }
        quadratic_form = l_add(quadratic_form, term);
        previous_forward_value = current_forward_value;
    }

    uvec2 quadratic_form_average;
    if (!l_divide(
            quadratic_form, l_from_uint(element_count),
            quadratic_form_average)) {
        return false;
    }
    const int matrix_exponent = int(scratch.values[
        current_scratch_index(matrix_exponent_logical_offset)].x);
    return l_to_q32_scaled_checked(
        quadratic_form_average,
        matrix_exponent - 2 * right_hand_side_exponent,
        variance);
}

bool add_pivot_logarithm(
    uvec2 pivot, inout uvec2 logarithm_sum) {
    uvec2 pivot_logarithm;
    if (!logarithm_of_positive_value(pivot, pivot_logarithm)) {
        return false;
    }
    logarithm_sum = q_add(logarithm_sum, pivot_logarithm);
    return true;
}

bool compute_entropy_scalar(uvec2 variance, out uvec2 entropy) {
    if (cv_i64_negative(variance) || !q_less(q_zero, q_sigma())) return false;
    const int variance_exponent = q_normalization_exponent_from_magnitude(
        cv_i64_magnitude(variance));
    const int sigma_exponent = q_normalization_exponent_from_magnitude(
        cv_i64_magnitude(q_sigma()));
    uvec2 normalized_variance;
    uvec2 normalized_sigma;
    if (!l_convert_public_with_exponent(
            variance, variance_exponent, normalized_variance) ||
        !l_convert_public_with_exponent(
            q_sigma(), sigma_exponent, normalized_sigma)) {
        return false;
    }
    const int matrix_exponent = int(scratch.values[
        current_scratch_index(matrix_exponent_logical_offset)].x);
    const int covariance_product_exponent =
        matrix_exponent + variance_exponent;
    const int shifted_matrix_exponent = cv_u64_is_zero(variance)
        ? sigma_exponent
        : min(covariance_product_exponent, sigma_exponent);
    const uvec2 aligned_sigma = l_scale(
        normalized_sigma,
        shifted_matrix_exponent - sigma_exponent);

    const uint diagonal_base = current_scratch_index(
        diagonal_logical_offset);
    const uint subdiagonal_base = current_scratch_index(
        subdiagonal_logical_offset);
    const int covariance_alignment_exponent =
        shifted_matrix_exponent - covariance_product_exponent;
    uvec2 current_diagonal_pivot = l_add(
        aligned_sigma,
        l_scale(
            l_multiply(
                normalized_variance,
                scratch.values[diagonal_base]),
            covariance_alignment_exponent));
    if (!l_less(l_zero, current_diagonal_pivot)) return false;

    uvec2 logarithm_sum = q_zero;
    if (!add_pivot_logarithm(
            current_diagonal_pivot, logarithm_sum)) {
        return false;
    }

    for (uint index = 0u; index + 1u < element_count; ++index) {
        const uvec2 current_shifted_subdiagonal = l_scale(
            l_multiply(
                normalized_variance,
                scratch.values[subdiagonal_base + index]),
            covariance_alignment_exponent);
        uvec2 multiplier;
        if (!l_divide(
                current_shifted_subdiagonal, current_diagonal_pivot,
                multiplier)) {
            return false;
        }
        const uvec2 next_shifted_diagonal = l_add(
            aligned_sigma,
            l_scale(
                l_multiply(
                    normalized_variance,
                    scratch.values[diagonal_base + index + 1u]),
                covariance_alignment_exponent));
        const uvec2 next_diagonal_pivot = l_subtract(
            next_shifted_diagonal,
            l_multiply(multiplier, current_shifted_subdiagonal));
        if (!l_less(l_zero, next_diagonal_pivot)) return false;
        if (!add_pivot_logarithm(
                next_diagonal_pivot, logarithm_sum)) {
            return false;
        }
        current_diagonal_pivot = next_diagonal_pivot;
    }

    entropy = q_subtract(
        logarithm_sum,
        q_from_int(shifted_matrix_exponent * int(element_count)));
    for (uint index = 0u; index < element_count; ++index) {
        entropy = q_add(entropy, q_log2_two_pi_e);
    }
    return true;
}

bool compute_block_statistics_scalar(uint block) {
    uvec2 variance;
    if (!compute_inverse_quadratic_form_scalar(block, variance)) {
        return false;
    }
    uvec2 entropy;
    if (!compute_entropy_scalar(variance, entropy)) return false;

    scratch.values[current_scratch_index(
        entropy_logical_offset() + block)] = entropy;
    scratch.values[current_scratch_index(
        variance_logical_offset() + block)] = variance;
    return true;
}
#endif

#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 4
// Computes the deterministic per-block contribution used by the tiled fold.
// The skip tests and both q_log2 calls retain the original order and every
// intermediate binary32 quantization point. finalize_base_entropy is staged
// once by lane 0 and read here by every lane of the workgroup.
uvec2 finalize_block_contribution(uint channel, uint block,
                                  out uint contribution_valid) {
    const uint reference_stream = channel * 2u;
    const uint distorted_stream = reference_stream + 1u;
    const uint reference_entropy = scratch_index_for_stream(
        reference_stream, entropy_logical_offset());
    const uint reference_variance = scratch_index_for_stream(
        reference_stream, variance_logical_offset());
    const uint distorted_entropy = scratch_index_for_stream(
        distorted_stream, entropy_logical_offset());
    const uint distorted_variance = scratch_index_for_stream(
        distorted_stream, variance_logical_offset());

    const uvec2 reference_entropy_value =
        scratch.values[reference_entropy + block];
    const uvec2 distorted_entropy_value =
        scratch.values[distorted_entropy + block];
    const uvec2 reference_variance_value =
        scratch.values[reference_variance + block];
    const uvec2 distorted_variance_value =
        scratch.values[distorted_variance + block];

    if ((q_less(reference_entropy_value, finalize_base_entropy) &&
         q_less(distorted_entropy_value, finalize_base_entropy)) ||
        (cv_u64_equal(reference_entropy_value, distorted_entropy_value) &&
         cv_u64_equal(reference_variance_value, distorted_variance_value))) {
        contribution_valid = 1u;
        return q_zero;
    }

    uvec2 reference_log;
    if (!q_log2(q_add(q_one, reference_variance_value), reference_log)) {
        contribution_valid = 0u;
        return q_zero;
    }
    const uvec2 weighted_variance = cv_u64_equal(
        reference_variance_value, distorted_variance_value)
        ? reference_variance_value
        : cv_q32_add_saturating(
            cv_q32_multiply_rne(q_three_quarters, reference_variance_value),
            cv_q32_multiply_rne(q_quarter, distorted_variance_value));
    uvec2 distorted_log;
    if (!q_log2(cv_q32_add_saturating(q_one, weighted_variance),
                distorted_log)) {
        contribution_valid = 0u;
        return q_zero;
    }
    const uvec2 spatial_reference = q_multiply(
        reference_entropy_value, reference_log);
    const uvec2 spatial_distorted = q_multiply(
        distorted_entropy_value, distorted_log);
    contribution_valid = 1u;
    return q_absolute(q_subtract(spatial_reference, spatial_distorted));
}

uvec2 clip_score(uvec2 score, uvec2 maximum) {
    return q_less(maximum, score) ? maximum : score;
}

void finalize_scores() {
    const uint local_lane = gl_LocalInvocationID.x;
    const uint channel = local_lane >> 5u;
    const uint lane_in_half = local_lane & 31u;

    // base_log/base_entropy are channel-independent, so compute them once.
    if (local_lane == 0u) {
        finalize_base_valid = 0u;
        uvec2 base_log;
        if (q_log2(
                q_multiply(q_add(q_one, q_nn_floor()), q_sigma()),
                base_log)) {
            finalize_base_entropy = q_multiply(
                q_from_uint(element_count),
                cv_q32_add_saturating(base_log, q_log2_two_pi_e));
            finalize_base_valid = 1u;
        }
    }
    barrier();

    const uint reference_stream = channel * 2u;
    const uint distorted_stream = reference_stream + 1u;
    const uvec2 reference_state = results.values[
        stream_state_index_for(reference_stream)];
    const uvec2 distorted_state = results.values[
        stream_state_index_for(distorted_stream)];
    const bool reference_singular =
        (reference_state.x & stream_singular_flag) != 0u;
    const bool distorted_singular =
        (distorted_state.x & stream_singular_flag) != 0u;
    const uint parameter_error_flags =
        (reference_state.x | distorted_state.x) &
        stream_arithmetic_failure_flag;

    const bool score_requested = parameter_error_flags == 0u &&
        reference_singular == distorted_singular &&
        finalize_base_valid == 1u;

    uvec2 score = q_zero;
    uint score_valid = 1u;
    // The tile loop and its barriers must stay uniform across all 64 lanes
    // even when one channel is singular and the other is not. Per-channel
    // work is gated by score_requested inside the uniform loop.
    for (uint tile_start = 0u;
         tile_start < parameters.block_count; tile_start += 32u) {
        const uint block = tile_start + lane_in_half;
        uint contribution_valid = 0u;
        uvec2 contribution = q_zero;
        if (score_requested && block < parameters.block_count) {
            contribution = finalize_block_contribution(
                channel, block, contribution_valid);
        }
        finalize_contributions[channel][lane_in_half] = contribution;
        finalize_contribution_valid[channel][lane_in_half] =
            contribution_valid;
        barrier();

        // lane 0 (U) and lane 32 (V) fold contributions in original
        // block-index order, preserving every q_add quantization step.
        if (lane_in_half == 0u && score_requested) {
            for (uint index = 0u;
                 index < 32u &&
                 tile_start + index < parameters.block_count;
                 ++index) {
                if (finalize_contribution_valid[channel][index] == 0u) {
                    score_valid = 0u;
                } else {
                    score = q_add(
                        score, finalize_contributions[channel][index]);
                }
            }
        }
        barrier();
    }

    if (lane_in_half == 0u) {
        bool channel_valid = parameter_error_flags == 0u;
        uvec2 channel_score = q_zero;
        if (channel_valid && reference_singular == distorted_singular) {
            if (score_valid == 1u && finalize_base_valid == 1u &&
                q_divide_by_u32(
                    score, parameters.block_count_divider,
                    channel_score)) {
                channel_valid = true;
            } else {
                channel_valid = false;
                channel_score = q_zero;
            }
        }
        finalize_channel_scores[channel] = channel_score;
        finalize_channel_flags[channel] = uvec2(
            (reference_singular || distorted_singular ? 1u : 0u) |
                parameter_error_flags | (channel_valid ? 0u : 2u),
            (reference_state.y & 0xffffu) |
                ((distorted_state.y & 0xffffu) << 16u));
    }
    barrier();

    if (local_lane == 0u) {
        const uvec2 maximum = uvec2(
            parameters.maximum_low, parameters.maximum_high);
        const bool u_singular = (finalize_channel_flags[0].x & 1u) != 0u;
        const bool v_singular = (finalize_channel_flags[1].x & 1u) != 0u;
        uvec2 uv_score = q_zero;
        bool valid = true;
        if (u_singular && !v_singular) {
            uv_score = finalize_channel_scores[1];
        } else if (v_singular && !u_singular) {
            uv_score = finalize_channel_scores[0];
        } else {
            uv_score = cv_q32_half_rne(cv_q32_add_saturating(
                finalize_channel_scores[0],
                finalize_channel_scores[1]));
        }
        results.values[result_packet_index(0u)] =
            clip_score(finalize_channel_scores[0], maximum);
        results.values[result_packet_index(2u)] =
            clip_score(finalize_channel_scores[1], maximum);
        results.values[result_packet_index(1u)] = finalize_channel_flags[0];
        results.values[result_packet_index(3u)] = finalize_channel_flags[1];
        results.values[result_packet_index(4u)] =
            clip_score(uv_score, maximum);
        results.values[result_packet_index(5u)] = uvec2(
            preprocessing_status.flags[
                current_batch_frame() *
                (parameters.status_frame_stride_elements == 0u
                    ? 1u
                    : parameters.status_frame_stride_elements)],
            valid ? 0u : 1u);
    }
}
#endif

void main() {
#if CROSSVMAF_SPEED_CHROMA_PIPELINE == 1
    if (current_parameter_stream() >= 4u) return;
    if (!initialize_grouped_mean()) {
        atomicOr(
            results.values[current_stream_state_index()].x,
            stream_arithmetic_failure_flag);
    }
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 2
    reduce_to_compact_tridiagonal_cooperatively();
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 3
    if (current_parameter_stream() >= 4u) return;
    const uint block = gl_WorkGroupID.x;
    if (block >= parameters.block_count) return;
    const uint state_index = current_stream_state_index();
    if ((results.values[state_index].x &
            stream_arithmetic_failure_flag) == 0u) {
        publish_transformed_right_hand_side(block);
        if (gl_LocalInvocationID.x == 0u && block_phase_failed != 0u) {
            atomicOr(
                results.values[state_index].x,
                stream_arithmetic_failure_flag);
        }
    }
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 4
    finalize_scores();
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 5
    if (current_parameter_stream() >= 4u) return;
    if (parameters.covariance_sample_count <= 524288u) {
        initialize_covariance_displacement(gl_WorkGroupID.x);
    } else {
        initialize_covariance_group(gl_WorkGroupID.x);
    }
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 6
    classify_and_factor_compact_tridiagonal_cooperatively();
#elif CROSSVMAF_SPEED_CHROMA_PIPELINE == 7
    if (current_parameter_stream() >= 4u) return;
    const uint block = gl_GlobalInvocationID.x;
    if (block >= parameters.block_count) return;
    const uint state_index = current_stream_state_index();
    if ((results.values[state_index].x &
            stream_arithmetic_failure_flag) == 0u &&
        !compute_block_statistics_scalar(block)) {
        atomicOr(
            results.values[state_index].x,
            stream_arithmetic_failure_flag);
    }
#endif
}

}

uint variance_logical_offset() {
    return block_statistics_logical_offset + parameters.block_count;
}

uint block_intermediate_logical_offset() {
    return block_statistics_logical_offset + 2u * parameters.block_count;
}

uint block_intermediate_base(uint block) {
    return block_intermediate_logical_offset() +
        block * block_intermediate_element_count;
}


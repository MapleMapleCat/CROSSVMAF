#version 450
#extension GL_GOOGLE_include_directive : require

#include "glsl/transcendentals.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputSamples {
    uvec2 values[];
} input_samples;
layout(set = 0, binding = 1, std430) writeonly buffer OutputSamples {
    uvec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
    uint width;
    uint height;
    uint filter_kind;
} parameters;

const uint sample_fractional_bits = 20u;

const uint antialias_filter[9] = uint[9](
    324909248u, 425645824u, 516207552u, 579548672u, 602344640u,
    579548672u, 516207552u, 425645824u, 324909248u);
const uint local_filter[3] = uint[3](
    714590272u, 2865786624u, 714590272u);

int mirror_coordinate(int coordinate, int size) {
    if (coordinate < 0) return -coordinate;
    if (coordinate >= size) return 2 * size - coordinate - 2;
    return coordinate;
}

void main() {
    const uint column = gl_GlobalInvocationID.x;
    const uint row = gl_GlobalInvocationID.y;
    const uint stream = gl_GlobalInvocationID.z;
    if (stream >= 4u) return;
    if (column >= parameters.width || row >= parameters.height) return;
    const uint stream_element_count = parameters.width * parameters.height;
    const uint stream_base = stream * stream_element_count;
    const int filter_size = parameters.filter_kind == 0u ? 9 : 3;
    const int radius = filter_size / 2;
    uvec2 accumulator = uvec2(0u);
    for (int tap = 0; tap < filter_size; ++tap) {
        const int source_row = mirror_coordinate(
            int(row) - radius + tap, int(parameters.height));
        const uint coefficient = parameters.filter_kind == 0u
            ? antialias_filter[tap]
            : local_filter[tap];
        const uvec2 sample_value = input_samples.values[
            stream_base + uint(source_row) * parameters.width + column];
        accumulator = cv_q32_binary32_add(
            accumulator,
            cv_q32_binary32_multiply(sample_value,
                                     uvec2(coefficient, 0u)));
    }
    output_samples.values[
        stream_base + row * parameters.width + column] = accumulator;
}

#version 450
#extension GL_GOOGLE_include_directive : require

#include "glsl/transcendentals.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ScoreRing {
    uvec2 values[];
} score_ring;
layout(set = 0, binding = 1, std430) buffer TemporalState {
    uvec2 previous_processed;
} temporal_state;
layout(set = 0, binding = 2, std430) writeonly buffer Results {
    uvec2 values[];
} results;

layout(push_constant) uniform Parameters {
    uint mode;
    uint first_slot;
    uint second_slot;
    uint output_count;
} parameters;

void main() {
    if (parameters.mode == 3u) {
        for (uint index = 0u; index < parameters.output_count; ++index) {
            results.values[index] = uvec2(0u);
        }
        return;
    }

    const uvec2 first = score_ring.values[parameters.first_slot];
    if (parameters.mode == 0u) {
        results.values[0] = first;
        if (parameters.output_count > 1u) results.values[1] = first;
        temporal_state.previous_processed = first;
        return;
    }

    uvec2 processed = first;
    if (parameters.second_slot != 0xffffffffu) {
        const uvec2 second = score_ring.values[parameters.second_slot];
        processed = cv_i64_less(first, second) ? first : second;
    }
    if (parameters.mode == 1u) {
        results.values[0] = processed;
        return;
    }
    results.values[0] = cv_q32_average_rne(
        processed, temporal_state.previous_processed);
    temporal_state.previous_processed = processed;
}
